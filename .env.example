# 环境变量模板 - 复制为 .env 后填入实际值
# .env 文件不会被 git 跟踪

# === scrapy-sina 与 eastmoney 项目需要的 MySQL 配置 ===
MYSQL_HOST=localhost
MYSQL_PORT=3306

# scrapy-sina
MYSQL_DATABASE=spider_sina
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_password_here

# eastmoney
MYSQL_DB=spider_eastmoney
MYSQL_USER=root

# === lianjia 项目需要的 Cookie ===
# 请在项目根目录创建 `爬虫数据项.txt`，\n# 按该项目 settings.py 里 read_request_value() 预期的格式填入
